# Kimi API 配置
# 从 https://platform.moonshot.cn/ 获取您的 API Key
MOONSHOT_API_KEY=your-api-key-here

# 可选配置
# KIMI_API_KEY=your-api-key-here                 # 向后兼容的旧变量名
# KIMI_BASE_URL=https://api.moonshot.cn/v1       # 代理 / 区域端点；留空则使用官方端点
# SEARCH_TIMEOUT=180                             # 单次请求超时（秒），同时作用于 chat 与 Formula 调用

# 无搜索模式：未设置 MOONSHOT_API_KEY / KIMI_API_KEY 时，agentcli 默认拒绝启动。
# 若确实要让模型凭记忆作答（Formula web_search 在 OpenRouter 上不可用），
# 必须同时设置 OPENROUTER_API_KEY 并显式传 -allow-no-search。
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=moonshotai/kimi-k2.6
