# 复制为 .env 后填入真实值。.env 不要提交到仓库。

# ---------- 模型提供商 ----------
# 可选：dashscope（== qwen / bailian）、siliconflow、doubao、kimi（== moonshot）、openrouter
LLM_PROVIDER=kimi

# 按所选 provider 填对应的 Key
KIMI_API_KEY=your-kimi-api-key-here
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# SILICONFLOW_API_KEY=your-siliconflow-api-key-here
# DOUBAO_API_KEY=your-doubao-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# 通用兜底：所选 provider 没有 Key 但设置了 OPENROUTER_API_KEY 时，
# 自动整体回落到 openrouter。此时不含斜杠的模型名会被置空，改用 OpenRouter 默认模型。

# 覆盖默认模型（可选）
# LLM_MODEL=kimi-k3
#
# 各 provider 默认模型：
#   dashscope/qwen/bailian  qwen3.7-plus
#   siliconflow             Qwen/Qwen3-235B-A22B-Thinking-2507
#   doubao                  doubao-seed-1-6-thinking-250715
#   kimi/moonshot           kimi-k3
#   openrouter              google/gemini-3.5-flash

# ---------- HTTP 服务 ----------
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8000

# ---------- MCP ----------
# ENABLE_MCP_TOOLS=false

# ---------- 实验 6-1（真实邮箱 + 日历）----------
# 两个值来自同一个 Unipile 项目。DSN 形如 apiN.unipile.com:PORT。
# 缺少任一值时实验不会降级跑假数据，而是停在 blocked 并留下证据。
# UNIPILE_DSN=apiN.unipile.com:PORT
# UNIPILE_ACCESS_TOKEN=your-unipile-api-key
